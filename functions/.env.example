# Copy to functions/.env (already git-ignored) and fill real values.
# Never commit the real .env. Firebase emulator picks this file up automatically;
# for production set these as secrets via `firebase functions:secrets:set KEY` or
# the Firebase web console.

# sandbox | production
NPI_ENV=sandbox

# test | live — 'test' simulates ConnectIPS (fake login page + deep-link return);
# 'live' calls the real NCHL endpoints. Defaults to 'test'.
NPI_MODE=test

# Base URL (FULL function path) of THIS backend as seen from the device, used for
# test-mode redirects. Must match the dart-define NPI_BASE_URL the app uses.
# Android emulator: http://10.0.2.2:5001/<project>/asia-south1/npi
# Physical device via LAN: http://<your-ip>:5001/<project>/asia-south1/npi
NPI_TEST_BASE_URL=http://10.0.2.2:5001/dhukuti-1e030/asia-south1/npi

# ConnectIPS Gateway (merchant interface) — from NCHL onboarding email
CONNECTIPS_BASE_URL=https://connectips.nchl.com
NPI_MERCHANT_ID=0000000000
NPI_APP_ID=MER-XXXX-APP-1
NPI_APP_NAME=Suvha Investment
# Basic Auth password for the REST APIs (login to ConnectIPS admin UI)
NPI_APP_PASSWORD=change-me

# CREDITOR signing key — MER-4263-APP-1 (collection/gateway). Prefer PEM
# (legacy NCHL PFX use RC2-40 which no runtime can read; convert once with:
#   openssl pkcs12 -legacy -in CREDITOR.pfx -out CREDITOR.pem -nodes -passin pass:123)
# CreditorIdentity: CN=CREDITOR, issuer MYTESTISSUER-CA (1024-bit, sample-cert!)
NPI_CREDITOR_PEM_PATH=
NPI_CREDITOR_PEM_BASE64=
NPI_CREDITOR_PFX_BASE64=
NPI_CREDITOR_PFX_PATH=
NPI_CREDITOR_PFX_PASSWORD=123

# Gateway QR on the payment landing page (NPI Gateway QR WebSocket)
NPI_QR_USERNAME=
NPI_QR_API_KEY=
NPI_QR_PUBLIC_KEY=
NPI_QR_WS_URL=
# NPI signing key for the QR gateway
NPI_QR_PEM_PATH=
NPI_QR_PEM_BASE64=
NPI_QR_PFX_BASE64=
NPI_QR_PFX_PATH=
NPI_QR_PFX_PASSWORD=123

# Where users land back after payment (ConnectIPS redirect success/failure URLs)
NPI_SUCCESS_URL=
NPI_FAILURE_URL=